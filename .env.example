# =========================
# SERVER

NODE_ENV=development
PORT=5000

# =========================
# DATABASE

MONGO_URI=mongodb://127.0.0.1:27017/itsm-platform

# =========================
# JWT

JWT_SECRET=replace-with-a-long-random-string

# =========================
# REDIS

REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# =========================
# FRONTEND

CLIENT_URL=http://localhost:5173

# ==========================================
# BOOTSTRAP
# One-time, operator-only secret used by POST /api/v1/auth/bootstrap.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==========================================

BOOTSTRAP_TOKEN=

# ==========================================
# SMTP (required for email verification and password reset)
# These values are loaded by src/services/email.service.ts and used by
# the email worker (src/workers/email.worker.ts) to send transactional
# email through the existing BullMQ `emails` queue.
#
# For local dev, services like Mailtrap or MailHog provide a safe SMTP
# capture. For production, point at a real provider (Gmail, SES, etc.).
# ==========================================

# The SMTP server hostname. Examples: smtp.gmail.com, smtp.sendgrid.net
SMTP_HOST=

# SMTP port (587 for STARTTLS, 465 for implicit TLS, 1025 for MailHog).
SMTP_PORT=587

# Set to "true" only when using port 465 (implicit TLS).
SMTP_SECURE=false

# The username used to authenticate to the SMTP server.
SMTP_USER=

# The password used to authenticate to the SMTP server.
# For Gmail use an App Password, not your account password.
SMTP_PASSWORD=

# Optional override for the From: header. Falls back to SMTP_USER if blank.
# Example: "ITSM Platform <no-reply@yourdomain.com>"
SMTP_FROM=
